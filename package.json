{
  "name": "lazu-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.0"
  },
  "scripts": {
    "dev": "pnpm dev:docs",
    "build:ui": "pnpm --dir packages/ui build",
    "build:frontend-kit-adapter": "pnpm exec tsup packages/frontend-kit-adapter/src/index.ts --format esm --dts --external react,react-dom --out-dir packages/frontend-kit-adapter/dist",
    "dev:docs": "pnpm --dir apps/docs dev",
    "build:docs": "pnpm --dir apps/docs build",
    "build:docs:pages": "pnpm --dir apps/docs build",
    "typecheck:docs": "pnpm --dir apps/docs typecheck",
    "typecheck:frontend-kit-adapter": "pnpm --dir packages/frontend-kit-adapter exec tsc -p tsconfig.json"
  }
}

{
  "name": "@maslazu/lazu-ui-frontend-kit-adapter",
  "version": "0.1.9",
  "description": "Lazu UI adapter for lazu-frontend-kit UI contracts",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasLazu/lazu-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "clean": "rm -rf dist .tsup",
    "build": "pnpm run clean && tsup src/index.ts --format esm --dts --external react,react-dom",
    "typecheck": "pnpm exec tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@maslazu/frontend-kit-ui-contracts": "^0.1.0",
    "@maslazu/lazu-ui": "workspace:*",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}

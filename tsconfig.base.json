{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["apps/docs/app/components/*"],
      "@/lib/*": ["apps/docs/app/lib/*"],
      "@maslazu/lazu-ui-frontend-kit-adapter": ["packages/frontend-kit-adapter/src/index.ts"],
      "@maslazu/lazu-ui-frontend-kit-adapter/*": ["packages/frontend-kit-adapter/src/*"],
      "@maslazu/lazu-ui": ["packages/ui/src/index.ts"],
      "@maslazu/lazu-ui/*": ["packages/ui/src/*"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
